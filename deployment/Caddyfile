{
	auto_https disable_redirects
	admin off
}
http://:8080 {
	log {
		output stdout
		format json
	}

	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 1MB
	}

	root * ./dist

	# Maintenance mode: while ./dist/maintenance.flag exists, every request is
	# served the maintenance page with a 503 status. Toggle it live (no restart):
	#   enable:  docker exec -u www-data <container> touch /opt/app/dist/maintenance.flag
	#   disable: docker exec -u www-data <container> rm    /opt/app/dist/maintenance.flag
	@maintenance file /maintenance.flag
	handle @maintenance {
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}

	@backend path /dung /setaf /bipolar /rankings /adf /serialisation /paf /iaf
	handle @backend {
		rate_limit {
			zone tweety {
				key {remote_host}
				events 60
				window 1m
			}
		}
		# log_append proxy_target http://localhost:8081
		reverse_proxy http://localhost:8081
	}

	@graph-gen path /graph-gen/*
	handle @graph-gen {
		rate_limit {
			zone graph_gen {
				key {remote_host}
				events 20
				window 1m
			}
		}
		uri strip_prefix /graph-gen
		reverse_proxy http://localhost:8082
	}

	@shares path /shares /shares/*
	handle @shares {
		reverse_proxy http://localhost:8001
	}

	# Usage analytics ingest. Rate limited per-IP; the limit is generous because
	# eval windows auto-request and a shared campus IP may carry many users.
	@events path /events
	handle @events {
		rate_limit {
			zone analytics {
				key {remote_host}
				events 300
				window 1m
			}
		}
		reverse_proxy http://localhost:8001
	}

	# Aggregated analytics readout — token-guarded by the share server itself.
	@stats path /stats
	handle @stats {
		reverse_proxy http://localhost:8001
	}

	# Argumentation MCP server (Streamable HTTP). The MCP server enforces OAuth
	# and its own request-size/timeout limits; Caddy adds a per-IP rate limit.
	# Returns 502 while the MCP process is disabled (no static token/issuer set).
	@mcp path /mcp /mcp/*
	handle @mcp {
		rate_limit {
			zone mcp {
				key {remote_host}
				events 60
				window 1m
			}
		}
		reverse_proxy http://localhost:8083
	}

	# OAuth 2.0 protected-resource metadata (RFC 9728), served by the MCP process.
	@oauth_metadata path /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
	handle @oauth_metadata {
		reverse_proxy http://localhost:8083
	}

	# Content-hashed build assets (Vite emits a hash in every filename) never
	# change once deployed, so they can be cached indefinitely.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# The index.html entry document (served here for every SPA route) must
		# be revalidated on each load. Without this, a browser can serve a stale
		# index.html from a previous deploy whose JS opens IndexedDB at an older
		# version, throwing a VersionError and leaving a blank page until the
		# user manually reloads.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
